{
  "modules": [
    "./voice.js"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Applications/FunMedalBridge.app/Contents/MacOS/funmedal-bridge\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Applications/FunMedalBridge.app/Contents/MacOS/funmedal-bridge\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Applications/FunMedalBridge.app/Contents/MacOS/funmedal-bridge\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Applications/FunMedalBridge.app/Contents/MacOS/funmedal-bridge\" hook",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Applications/FunMedalBridge.app/Contents/MacOS/funmedal-bridge\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Applications/FunMedalBridge.app/Contents/MacOS/funmedal-bridge\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Applications/FunMedalBridge.app/Contents/MacOS/funmedal-bridge\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Applications/FunMedalBridge.app/Contents/MacOS/funmedal-bridge\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Applications/FunMedalBridge.app/Contents/MacOS/funmedal-bridge\" hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

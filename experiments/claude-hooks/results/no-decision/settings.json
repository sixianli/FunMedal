{
  "sandbox": {
    "enabled": false
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 <repo>/experiments/claude-hooks/hook_probe.py permission",
            "timeout": 60
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 <repo>/experiments/claude-hooks/hook_probe.py notification"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 <repo>/experiments/claude-hooks/hook_probe.py pretooluse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 <repo>/experiments/claude-hooks/hook_probe.py posttooluse"
          }
        ]
      }
    ]
  }
}